# ===== Mediatracker =====
# Скопируй в .env и заполни значения

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tracker
DATABASE_URL=postgresql://***@db:5432/${POSTGRES_DB}

# --- Сервер ---
HOST=0.0.0.0
PORT=8080
RUST_LOG=info
APP_BASE_URL=

# --- Внешние API ---
TMDB_API_KEY=
RAWG_API_KEY=

# --- Comic Vine (западные комиксы Marvel/DC) ---
COMIC_VINE_API_KEY=

# --- Hardcover (книги) ---
HARDCOVER_API_KEY=

# --- Bilibili (официальный источник маньхуа) ---
# Cookie живой сессии аккаунта; без него часть глав недоступна.
BILIBILI_COOKIE=

# --- IGDB (игры) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Telegram (уведомления) ---
TELEGRAM_BOT_TOKEN=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Тюнинг (необязательно) ---
# Пул соединений с БД: по умолчанию 10 соединений и 30 с на acquire.
DATABASE_MAX_CONNECTIONS=
DATABASE_ACQUIRE_TIMEOUT=
# Лимит auth-запросов на IP в минуту (по умолчанию 10).
RATE_LIMIT_PER_MIN=
# Лимит поиска/дровера/глав на IP в минуту (по умолчанию 30): эти пути
# веерно ходят до 9 официальных источников за один запрос.
SEARCH_RATE_LIMIT_PER_MIN=
# Интервал фонового обновления счётчиков, сек (по умолчанию 1800).
REFRESH_INTERVAL_SECS=
# Фоновый refresh-цикл в этом процессе: true/1 включает (по умолчанию включён).
REFRESH_LOOP_ENABLED=
# HTTP-сервер в этом процессе: false/0/no выключает (режим выделенного воркера).
SERVE_HTTP=

# --- Устаревшие (приложение их не читает) ---
# MAL работает через Shikimori/Tenrai/Jikan, email — через Resend.
# Ключи остаются в SOPS-бандле до отдельной ревизии секретов.
SECRET_KEY=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
TELEGRAM_CHAT_ID=
MAILERSEND_SMTP_USER=
MAILERSEND_SMTP_PASS=
