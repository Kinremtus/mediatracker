.env
# Real .env variants (keep the tracked template): .env.local, .env.prod, ...
.env.*
!/.env.example
__pycache__/
*.pyc
*.sql.gz
# Database dumps (backup-db.sh honours a custom BACKUP_DIR outside backups/).
*.dump
*.dump.age
backups/

# Added by cargo
/target

# Local k8s manifests with secrets
k8s/cloudflared/secret.yaml
k8s/cloudflared/credentials*.json
k8s/monitoring/telegram-secret.yaml
terraform/monitoring/telegram-secret.tf

# Local postgres data (docker volume mount)
postgres_data/

# Decrypted/plaintext secret material. The SOPS-encrypted k8s/secrets/*.enc.yaml
# files ARE committed on purpose; only decrypted artifacts and age keys are ignored.
k8s/secrets/*.plain.yaml
k8s/secrets/*.dec.yaml
k8s/secrets/age-key*.txt

# Local AI tooling config
.opencode/
AGENTS.md
opencode.json

terraform/terraform.tfvars
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
**/.terraform/
thoughts/
.harness-memory/